{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{venv/**,.venv/**,env/**,api/**,tests/**,**/__pycache__/**,**/*.pyc,**/*.pyo,.pytest_cache/**,tailwindcss.exe,tailwind.config.js,static/css/tailwind-input.css,uploads/**,*.db,*.sqlite3,.env,.env.*,.vscode/**,.idea/**,README.md,requirements.txt}"
    }
  }
}
